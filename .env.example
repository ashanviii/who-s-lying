# Required for real analyses. Without this, the app runs in demo mode and
# every "Analyze" click returns the pre-written example result instead of
# calling any external API.
ANTHROPIC_API_KEY=

# Optional. Anthropic model used for both claim extraction and web-search
# based scoring. Defaults to claude-opus-5. Swap in a cheaper model
# (e.g. claude-sonnet-5 or claude-haiku-4-5) to cut cost/latency.
ANTHROPIC_MODEL=claude-opus-5
