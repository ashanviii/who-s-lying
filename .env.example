# Required for real analyses. Without this, the app runs in demo mode and
# every "Analyze" click returns the pre-written example result instead of
# calling any external API.
OPENAI_API_KEY=

# Optional. OpenAI model used for both claim extraction and web-search
# based scoring, via the Responses API. Defaults to gpt-5. Swap in a
# cheaper model (e.g. gpt-4.1 or gpt-4o-mini) to cut cost/latency.
OPENAI_MODEL=gpt-5
